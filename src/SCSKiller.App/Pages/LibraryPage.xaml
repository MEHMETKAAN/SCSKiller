<Page
    x:Class="SCSKiller.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App"
    NavigationCacheMode="Required">

    <Page.Resources>
        <CollectionViewSource x:Key="GroupedGames" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="36,28,36,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kütüphane" Style="{StaticResource TitleTextBlockStyle}" TextLineBounds="TrimToBaseline" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource Secondary}"
                                   TextLineBounds="TrimToBaseline" VerticalAlignment="Bottom" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Text="{x:Bind Vm.RefreshNote, Mode=OneWay}" Visibility="{x:Bind Vm.HasRefreshNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                </StackPanel>
                <local:WrapPanel Grid.Row="1" Spacing="12" LineAlignment="Right">
                    <Button ToolTipService.ToolTip="Her oyunun önbellek boyutunu, kaydını ve durumunu yeniden okur ve yeni oyunları bulur. Shift+click ile ayrıca her oyunun motorunu ve anti-cheat durumunu da yeniden kontrol eder."
                            Click="OnRefresh" IsEnabled="{x:Bind Vm.CanRefresh, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.Refreshing, Mode=OneWay}" Visibility="{x:Bind Vm.Refreshing, Mode=OneWay}" />
                            <TextBlock Text="Yenile" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Bir oyun ekle" ToolTipService.ToolTip="Mağaza tarafından listelenmeyen bir oyunu (başka bir başlatıcı veya kendi klasöründe bulunan oyun) .exe dosyasını seçerek ekleyin." Click="OnAddGame">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Oyun ekle…" />
                        </StackPanel>
                    </Button>
                    <DropDownButton AutomationProperties.Name="Oyun klasörleri" ToolTipService.ToolTip="Mağaza tarafından listelenmeyen oyun klasörleri: SCSKiller her taramada bunlara bakar">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="Oyun klasörleri" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="FoldersMenu" Placement="Bottom" Opening="OnFoldersOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Content="{x:Bind Vm.AddAllText, Mode=OneWay}" Click="OnAddAll" IsEnabled="{x:Bind Vm.CanAddAll, Mode=OneWay}" />
                    <Grid>
                        <Button ToolTipService.ToolTip="Derleme yapılmayan, takılma sorunu olan ve hazır olan tüm oyunları sıraya ekler" Click="OnAddRecommended" Visibility="{x:Bind Vm.CanAddRecommended, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="{x:Bind Vm.AddRecommendedText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Vm.AddRecommendedText, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button IsEnabled="False" Visibility="{x:Bind Vm.CannotAddRecommended, Mode=OneWay}" BorderThickness="1.5"
                                AutomationProperties.Name="{x:Bind Vm.AddRecommendedText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="14" />
                                <TextBlock Text="{x:Bind Vm.AddRecommendedText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnCompileQueue" IsEnabled="{x:Bind Vm.CanCompileQueue, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="14" />
                            <TextBlock Text="{x:Bind Vm.CompileQueueText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </local:WrapPanel>
            </Grid>
            <InfoBar Severity="Error" IsOpen="{x:Bind Vm.HasError, Mode=OneWay}" Visibility="{x:Bind Vm.HasError, Mode=OneWay}" Message="{x:Bind Vm.Error, Mode=OneWay}" IsClosable="False" />
            <InfoBar Severity="Informational" IsOpen="{x:Bind Vm.HasGpuNotice, Mode=OneWay}" Visibility="{x:Bind Vm.HasGpuNotice, Mode=OneWay}"
                     Message="{x:Bind Vm.GpuNotice, Mode=OneWay}" CloseButtonClick="OnDismissGpuNotice" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sürücü shader önbelleği" Style="{StaticResource Secondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Vm.CacheUsed, Mode=OneWay}" Style="{StaticResource Big}" />
                        <TextBlock Text="{x:Bind Vm.CacheLimitText, Mode=OneWay}" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind Vm.CachePercent, Mode=OneWay}" AutomationProperties.Name="Sürücü shader önbelleği kullanımı" />
                    <Grid ColumnSpacing="6" Visibility="{x:Bind Vm.CacheWarn, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarnBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Vm.CacheWarnText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Vm.HasOldDriver, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.OldDriverNote, Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <HyperlinkButton Content="Boşalt" Padding="0" FontSize="12" Click="OnCache" AutomationProperties.Name="Yeni sürücü artık kullanmayan önbelleği boşalt" />
                    </StackPanel>
                    <HyperlinkButton Content="Değiştir" Padding="0" FontSize="12" Click="OnSettings" Visibility="{x:Bind Vm.CanRaiseLimit, Mode=OneWay}"
                                     AutomationProperties.Name="Sürücü shader önbellek boyutunu değiştir" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sürücü güncellemesinden sonra" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{x:Bind Vm.DriverMode, Mode=OneWay}" Style="{StaticResource Big}" />
                    <TextBlock Text="{x:Bind Vm.DriverModeNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                    <HyperlinkButton Content="Değiştir" Padding="0" FontSize="12" Click="OnSettings" AutomationProperties.Name="Sürücü güncellemesinden sonra ne olacağını değiştir" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Derleme hızı" Style="{StaticResource Secondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Vm.Threads, Mode=OneWay}" Style="{StaticResource Big}" />
                        <TextBlock Text="{x:Bind Vm.ThreadsOf, Mode=OneWay}" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.SpeedNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                    <HyperlinkButton Content="Değiştir" Padding="0" FontSize="12" Click="OnSettings" AutomationProperties.Name="Derleme hızını değiştir" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Padding="20,14,20,4" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="Search" PlaceholderText="İsim, mağaza veya motor ile ara" QueryIcon="Find"
                                    TextChanged="OnSearch" KeyDown="OnSearchKey" AutomationProperties.Name="Oyunları ara" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <ComboBox ItemsSource="{x:Bind local:LibraryVm.ShowLabels}" SelectedIndex="{x:Bind Vm.ShowIndex, Mode=TwoWay}"
                                  MinWidth="200" AutomationProperties.Name="Oyunları durumuna göre göster" />
                        <CheckBox Content="Gizlileri göster" IsChecked="{x:Bind Vm.ShowHidden, Mode=TwoWay}" Visibility="{x:Bind Vm.HasHidden, Mode=OneWay}"
                                  MinWidth="0" ToolTipService.ToolTip="Kütüphaneden kaldırdığınız oyunlar" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.ShownText, Mode=OneWay}" Visibility="{x:Bind Vm.Filtering, Mode=OneWay}"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{x:Bind Vm.Hidden, Mode=OneWay}" Visibility="{x:Bind Vm.HiddenShown, Mode=OneWay}"
                                  Margin="0,8,0,4" AutomationProperties.Name="Gizli oyunlar">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:HiddenRow">
                                <StackPanel Orientation="Horizontal" Spacing="12" MinHeight="32">
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Store}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <HyperlinkButton Content="Kütüphanede göster" Click="OnShowGame" Padding="0" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Bind ShowName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Column="3" ColumnSpacing="8" Visibility="{x:Bind Vm.ScanBusy, Mode=OneWay}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.ScanBusy, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind Vm.ScanBusyNote, Mode=OneWay}">
                            <Run Text="{x:Bind Vm.ScanTitle, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" Margin="20,0,20,0" ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" MinWidth="160" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="4.1*" MinWidth="355" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SortHeader}" Click="OnSortName" ToolTipService.ToolTip="Ada göre sırala">
                        <TextBlock Text="{x:Bind Vm.GameHeader, Mode=OneWay}" Style="{StaticResource Caption}" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="Shader'lar" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource SortHeader}" HorizontalAlignment="Right" Click="OnSortPipelines" ToolTipService.ToolTip="Pipeline'lara göre sırala">
                        <TextBlock Text="{x:Bind Vm.PipelinesHeader, Mode=OneWay}" Style="{StaticResource Caption}" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource SortHeader}" HorizontalAlignment="Right" Click="OnSortCache" ToolTipService.ToolTip="Önbellek boyutuna göre sırala">
                        <TextBlock Text="{x:Bind Vm.CacheHeader, Mode=OneWay}" Style="{StaticResource Caption}" />
                    </Button>
                    <TextBlock Grid.Column="4" Text="Zaman" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center" />
                    <Button Grid.Column="5" Style="{StaticResource SortHeader}" Margin="12,0,0,0" Click="OnSortStatus" ToolTipService.ToolTip="Duruma göre sırala, ilk olarak olduğu gibi">
                        <TextBlock Text="Durum" Style="{StaticResource Caption}" />
                    </Button>
                </Grid>
                <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <StackPanel Grid.Row="2" Visibility="{x:Bind Vm.NoMatch, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" MaxWidth="460" Padding="24">
                    <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.NoMatchText, Mode=OneWay}" Style="{StaticResource Section}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="İsmin bir kısmını, mağazayı (Steam, GOG…) veya motoru (UE 5) deneyin." Style="{StaticResource Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Visibility="{x:Bind Vm.Searching, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Visibility="{x:Bind Vm.ScanEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" MaxWidth="460" Padding="24">
                    <ProgressRing Width="32" Height="32" IsActive="{x:Bind Vm.ScanEmpty, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Vm.ScanEmptyTitle, Mode=OneWay}" Style="{StaticResource Section}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.ScanEmptyNote, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <ListView x:Name="List" Grid.Row="2" ItemsSource="{Binding Source={StaticResource GroupedGames}}" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnGameClick" AutomationProperties.Name="Oyunlar" Padding="0,4">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderContainerStyle>
                                <Style TargetType="ListViewHeaderItem">
                                    <Setter Property="Padding" Value="20,12,20,4" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </GroupStyle.HeaderContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="local:StoreGroup">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Store}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind CountText, Mode=OneWay}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:GameRow">
                            <Grid ColumnSpacing="12" MinHeight="56" x:DefaultBindMode="OneWay">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.6*" MinWidth="160" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="4.1*" MinWidth="355" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{x:Bind Tile}" Visibility="{x:Bind NoIcon}">
                                        <TextBlock Text="{x:Bind Initials}" FontSize="13" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{x:Bind Icon}" Width="32" Height="32" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,6">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Sub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <local:WrapPanel Spacing="4" Visibility="{x:Bind HasTagLine}" Margin="0,2,0,0">
                                            <Border Style="{StaticResource Chip}" Height="18" Padding="6,0" CornerRadius="9" Visibility="{x:Bind IsKnownStutter}"
                                                    ToolTipService.ToolTip="{x:Bind StutterTip}">
                                                <TextBlock Text="Derleme olmadan takılır" FontSize="11" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Height="18" Padding="6,0" CornerRadius="9" Visibility="{x:Bind IsNoStutter}"
                                                    ToolTipService.ToolTip="{x:Bind NoStutterTip}">
                                                <TextBlock Text="Shader stutter yok" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Height="18" Padding="6,0" CornerRadius="9" Visibility="{x:Bind HasBaChip}">
                                                <TextBlock Text="{x:Bind BaChip}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Border>
                                            <ItemsControl ItemsSource="{x:Bind Tags}" IsTabStop="False" Visibility="{x:Bind HasTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:WrapPanel Spacing="4" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:TagChip">
                                                        <Border Style="{StaticResource Chip}" Height="18" Padding="{x:Bind Pad}" CornerRadius="9" ToolTipService.ToolTip="{x:Bind Tip}" x:DefaultBindMode="OneWay">
                                                            <TextBlock Text="{x:Bind Text}" FontSize="11" MaxWidth="{x:Bind Width}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </local:WrapPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind Shaders}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Pipelines}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Cache}" Style="{x:Bind CacheStyle}" ToolTipService.ToolTip="{x:Bind CacheTip}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Time}" TextAlignment="Right" VerticalAlignment="Center" />
                                <Grid Grid.Column="5" ColumnSpacing="12" Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,6" Background="Transparent" ToolTipService.ToolTip="{x:Bind RowTip}">
                                        <TextBlock Style="{x:Bind StatusStyle}" FontSize="13" TextTrimming="CharacterEllipsis">
                                            <Run Text="●" FontSize="10" /><Run Text="  " /><Run Text="{x:Bind StatusText}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind RowNote}" Visibility="{x:Bind HasRowNote}" Style="{StaticResource Caption}" Margin="16,0,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind PlayTip}" Visibility="{x:Bind CanLaunch}">
                                            <Button Content="{x:Bind PlayText}" IsEnabled="{x:Bind CanPlay}" Click="OnPlay" />
                                        </Grid>
                                        <Grid>
                                            <Button Content="{x:Bind AddText}" Visibility="{x:Bind IsAdd}" IsEnabled="{x:Bind CanAdd}" Click="OnAdd" />
                                            <Button Content="Ayrıntılar" Visibility="{x:Bind IsDetails}" Click="OnDetails" />
                                            <Button Content="Kaydet" Style="{StaticResource WarnButton}" Visibility="{x:Bind IsRecord}" IsEnabled="{x:Bind CanRecord}" Click="OnRecord" />
                                            <Button Content="Neden?" Visibility="{x:Bind IsWhy}" Click="OnWhy" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
