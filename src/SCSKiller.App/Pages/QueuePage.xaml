<Page
    x:Class="SCSKiller.App.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App">

    <Page.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="36,28,36,28" Spacing="20">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Derleme kuyruğu" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{x:Bind Vm.PlanChecks, Mode=OneWay}" Visibility="{x:Bind Vm.HasPlanChecks, Mode=OneWay}" Style="{StaticResource Caption}"
                               ToolTipService.ToolTip="Bir güncellemenin ardından SCSKiller arka planda derlenmiş oyunların planlarını yeniden oluşturur; bu sırada derleme yapılmaz. Daha çok derlenecek şey kalan bir oyun bunun için burada gösterilir." />
                    <TextBlock Text="Derlemeler oyunun dışında, oyunun adının altında çalışır. Çalışırken oyunu kapalı tutun."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnStart"
                            Visibility="{x:Bind Vm.Idle, Mode=OneWay}" IsEnabled="{x:Bind Vm.CanStart, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="14" />
                            <TextBlock Text="Derleme kuyruğu" />
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Bind Vm.PauseText, Mode=OneWay}" Click="OnPause" Visibility="{x:Bind Vm.HasCurrent, Mode=OneWay}" />
                    <Button Content="Durdur" Click="OnStop" Visibility="{x:Bind Vm.HasCurrent, Mode=OneWay}"
                            ToolTipService.ToolTip="Devam eden derlemeleri bitirir, ardından durur. Durdurulan oyunu tekrar ekleyerek kaldığı yerden devam edebilirsiniz." />
                </StackPanel>
            </Grid>

            <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind Vm.CacheWarn, Mode=OneWay}" Visibility="{x:Bind Vm.CacheWarn, Mode=OneWay}"
                     Message="{x:Bind Vm.CacheWarnText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Limiti artır" Click="OnSettings" Visibility="{x:Bind Vm.CanRaiseLimit, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Height="40" Margin="16,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition MinWidth="160" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="216" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="Oyun (çalışma sırasına göre)" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Süre" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Önbellek" Style="{StaticResource Caption}" TextAlignment="Right" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{x:Bind Vm.CanClear, Mode=OneWay}">
                            <Grid Background="Transparent" ToolTipService.ToolTip="Ctrl+click veya Shift+click ile birkaç oyunu seçebilirsiniz">
                                <HyperlinkButton x:Name="RemoveSelected" Content="Seçilenleri kaldır" FontSize="12" IsEnabled="False" Click="OnRemoveSelected" />
                            </Grid>
                            <HyperlinkButton Content="Kuyruğu temizle" FontSize="12" Click="OnClearQueue" ToolTipService.ToolTip="Derleme yapan oyundan başka herkesi kaldırır" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <StackPanel Padding="20,32" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind Vm.Empty, Mode=OneWay}">
                        <TextBlock Text="Kütüphaneden oyun ekleyin" Style="{StaticResource Section}" HorizontalAlignment="Center" />
                        <TextBlock Text="Bir oyunun üzerinde Sıraya ekle'ye basın, sonra Derleme kuyruğu'na tıklayın." Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
                        <HyperlinkButton Content="Kütüphaneyi aç" Click="OnLibrary" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="16,10,16,10" ColumnSpacing="12" RowSpacing="6" Visibility="{x:Bind Vm.HasCurrent, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition MinWidth="160" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="216" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="2" Width="32" Height="32">
                            <Border CornerRadius="8" Background="{x:Bind Vm.Current.Tile, Mode=OneWay}" Visibility="{x:Bind Vm.Current.NoIcon, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Vm.Current.Initials, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Source="{x:Bind Vm.Current.Icon, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Vm.Current.Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Vm.CurrentDetail, Mode=OneWay}" Style="{StaticResource Caption}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{x:Bind Vm.Current.Time, Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Vm.Current.Cache, Mode=OneWay}" TextAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource RowButton}" Click="OnRemoveCurrent"
                                AutomationProperties.Name="{x:Bind Vm.Current.RemoveLabel, Mode=OneWay}" ToolTipService.ToolTip="Durdur ve kaldır">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                        <ProgressBar Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Value="{x:Bind Vm.Percent, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind Vm.Indeterminate, Mode=OneWay}" AutomationProperties.Name="Derleme ilerlemesi" />
                    </Grid>

                    <ListView x:Name="WaitingList" ItemsSource="{x:Bind Vm.Waiting}" SelectionMode="Extended" SelectionChanged="OnSelection"
                              CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsStarting="OnDragStarting" DragItemsCompleted="OnDragCompleted" AutomationProperties.Name="Bekleyen oyunlar"
                              ItemContainerStyle="{StaticResource RowItem}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:QueueRow">
                                <Grid ColumnSpacing="12" MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition MinWidth="160" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="216" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE76F;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" ToolTipService.ToolTip="Sıralamak için sürükleyin" />
                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Number}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Grid Grid.Column="2" Width="32" Height="32">
                                        <Border CornerRadius="8" Background="{x:Bind Tile}" Visibility="{x:Bind NoIcon}">
                                            <TextBlock Text="{x:Bind Initials}" FontSize="12" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{x:Bind Icon}" />
                                    </Grid>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="0,6">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Note}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="3" ToolTipService.ToolTip="{x:Bind Note}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Time}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Cache}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                        <Button Content="En üste taşı" Style="{StaticResource RowButton}" FontSize="13" IsEnabled="{x:Bind CanUp}" Click="OnTop"
                                                AutomationProperties.Name="{x:Bind TopLabel}" />
                                        <Button Style="{StaticResource RowButton}" Padding="0" IsEnabled="{x:Bind CanUp}" Click="OnUp"
                                                AutomationProperties.Name="{x:Bind UpLabel}" ToolTipService.ToolTip="Yukarı taşı">
                                            <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Padding="0" IsEnabled="{x:Bind CanDown}" Click="OnDown"
                                                AutomationProperties.Name="{x:Bind DownLabel}" ToolTipService.ToolTip="Aşağı taşı">
                                            <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Padding="0" Click="OnRemove"
                                                AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="Kaldır">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Visibility="{x:Bind Vm.HasFinished, Mode=OneWay}" Padding="0,0,0,8">
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Margin="16,6,16,0">
                            <TextBlock Text="Bitti" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Bitmişleri temizle" HorizontalAlignment="Right" FontSize="12" Click="OnClearFinished" />
                        </Grid>
                        <ListView ItemsSource="{x:Bind Vm.Finished}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnGameClick"
                                  ItemContainerStyle="{StaticResource RowItem}" AutomationProperties.Name="Bitmiş oyunlar">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:QueueRow">
                                    <Grid ColumnSpacing="12" MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition MinWidth="160" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="216" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid Grid.Column="2" Width="32" Height="32" Opacity="0.55">
                                            <Border CornerRadius="8" Background="{x:Bind Tile}" Visibility="{x:Bind NoIcon}">
                                                <TextBlock Text="{x:Bind Initials}" FontSize="12" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{x:Bind Icon}" />
                                        </Grid>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind Note}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind Cache}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource RowButton}" Padding="0" Click="OnRemove"
                                                AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="Kaldır">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Header="{x:Bind Vm.CpuSummary, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Derleme iş parçacıkları" />
                        <TextBlock Text="{x:Bind Vm.ThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.Threads, Mode=TwoWay}"
                            AutomationProperties.Name="Derleme iş parçacıkları" />
                    <RadioButtons Header="Öncelik" SelectedIndex="{x:Bind Vm.Priority, Mode=TwoWay}">
                        <RadioButton Content="Normalin altında: en hızlı, bilgisayar kullanılabilir kalır" />
                        <RadioButton Content="Yalnızca boşta: CPU başka işe ihtiyaç duymazsa çalışır" />
                    </RadioButtons>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
