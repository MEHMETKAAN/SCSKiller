<Page
    x:Class="SCSKiller.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SCSKiller.App">

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="36,28,36,28" Spacing="16">
            <TextBlock Text="Ayarlar" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Vm.CacheTitle}" Style="{StaticResource Section}" />
                        <TextBlock Text="{x:Bind Vm.CacheIntro, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Geçerli limit" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.CurrentLimit, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Şimdi kullanılan" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Used, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{x:Bind Vm.FreeLabel, Mode=OneWay}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Vm.Free, Mode=OneWay}" Style="{StaticResource Section}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" Visibility="{x:Bind Vm.Configurable}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NewLimitLabel" Text="Yeni limit" VerticalAlignment="Center" />
                            <ComboBox x:Name="SizeBox" Grid.Column="1" ItemsSource="{x:Bind local:SettingsVm.SizeLabels}" MinWidth="220"
                                      SelectedIndex="{x:Bind Vm.SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{x:Bind NewLimitLabel}" />
                            <Button x:Name="ApplyButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnApply">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                    <TextBlock Text="Uygula (yönetici gerekir)" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <InfoBar IsOpen="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasApplyMessage, Mode=OneWay}" Message="{x:Bind Vm.ApplyMessage, Mode=OneWay}"
                                 Severity="{x:Bind Vm.ApplySeverity, Mode=OneWay}" IsClosable="False" />
                        <TextBlock Text="İsterseniz daha sonra sürücünün varsayılan değerine geri dönebilirsiniz." Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Spacing="6" Visibility="{x:Bind Vm.HasAmdUse, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.AmdUse, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind Vm.AmdPercent, Mode=OneWay}" AutomationProperties.Name="AMD DirectX 12 önbellek kullanımı" />
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind Vm.NotConfigurable}" Visibility="{x:Bind Vm.NotConfigurable}" Severity="Informational" IsClosable="False" Message="{x:Bind Vm.NotConfigurableText, Mode=OneWay}" />
                    <Grid ColumnSpacing="12" Visibility="{x:Bind Vm.IsAmd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Derlenmiş önbellekleri kenara ayır" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Sürücü tarafından kaldırılan bir oyunun derlenmiş önbelleğini geri getirir." Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" Visibility="{x:Bind Vm.HasKept, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Vm.KeptSummary, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="Yönet…" Click="OnManageKept" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Top" OnContent="" OffContent=""
                                      IsOn="{x:Bind Vm.KeepCachesAside, Mode=TwoWay}" AutomationProperties.Name="Derlenmiş önbellekleri kenara ayır" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Sürücü güncellemesinden sonra" Style="{StaticResource Section}" />
                        <TextBlock Text="Yeni bir sürücü tüm derlenmiş shader'ları siler; bu yüzden derlenmiş oyunlar yeniden oluşturulana kadar tekrar takılmaya başlar."
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons SelectedIndex="{x:Bind Vm.DriverMode, Mode=TwoWay}" AutomationProperties.Name="Yeniden oluşturma zamanı">
                            <RadioButton AutomationProperties.Name="Bana sor">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Bana sor" />
                                    <TextBlock Text="Bir bildirim Şimdi derle, Boşta olduğunda veya Atla seçenekleri sunar. Kendi kendine hiçbir şey başlatılmaz." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Yalnızca bilgisayar boşsa otomatik">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Yalnızca bilgisayar boşsa otomatik" />
                                    <TextBlock Text="Fare veya klavye dokunulunca aniden durur ve kaldığı yerden devam eder." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Kapalı">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Kapalı" />
                                    <TextBlock Text="Oyunları Kütüphane'den kendiniz yeniden oluşturursunuz." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind Vm.LastRebuilt, Mode=OneWay}" Style="{StaticResource Caption}" Visibility="{x:Bind Vm.HasLastRebuilt, Mode=OneWay}" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="NewShadersHeader" Text="Oyunlarda yeni shader'lar olduğunda" Style="{StaticResource Section}" />
                        <TextBlock Text="Derlenmiş bir oyunda kaydından, paylaşılan shader hash'lerinden veya bir SCSKiller güncellemesinden yeni pipeline'lar oluşur. Oynarken asla olmaz."
                                   Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        <RadioButtons SelectedIndex="{x:Bind Vm.NewShadersChoice, Mode=TwoWay}" AutomationProperties.Name="Oyunlarda yeni shader'lar olduğunda">
                            <RadioButton AutomationProperties.Name="Kapalı">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Kapalı" />
                                    <TextBlock Text="Oyunları Kütüphane'den kendiniz derlersiniz." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Beni bilgilendir">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Beni bilgilendir" />
                                    <TextBlock Text="Bir bildirim Şimdi derle teklif eder. Kendi kendine hiçbir şey başlatılmaz." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Otomatik olarak derle ve beni bilgilendir">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Otomatik olarak derle ve beni bilgilendir" />
                                    <TextBlock Text="Bilgisayar boşken derler ve sıraya alındığını bildirir." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton AutomationProperties.Name="Otomatik olarak derle, sessizce">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Otomatik olarak derle, sessizce" />
                                    <TextBlock Text="Bilgisayar boşken bildirim olmadan derler." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <CheckBox Content="Başka oyun çalışırken arka plan derlemeyi duraklat" IsChecked="{x:Bind Vm.PauseWhileGaming, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock Text="Arka plan yeniden derlemeleri için iş parçacıkları" />
                            <TextBlock Text="{x:Bind Vm.BackgroundThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.BackgroundThreads, Mode=TwoWay}"
                                AutomationProperties.Name="Arka plan yeniden derlemeleri için iş parçacıkları" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border x:Name="PatreonCard" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Patreon ve topluluk veritabanı" Style="{StaticResource Section}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedOut, Mode=OneWay}">
                                <TextBlock Text="Patreon destekçileri topluluk shader hash veritabanı ve beta/alpha sürümlerine erişir. SCSKiller'ı desteklediğiniz Patreon hesabıyla giriş yapın."
                                           Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="Patreon ile giriş yap" Click="OnSignIn" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="İptal" Click="OnCancelSignIn" Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="Tarayıcıda giriş işlemini tamamlayın. Burada başka bir şey yapmanıza gerek yok." Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Visibility="{x:Bind Patreon.SigningIn, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{x:Bind Patreon.SignedIn, Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Patreon ile giriş yapıldı" />
                                    <TextBlock Text="{x:Bind Patreon.Benefits, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Durumu yenile" Click="OnRefreshAccount" IsEnabled="{x:Bind Patreon.Idle, Mode=OneWay}" />
                                    <Button Content="Çıkış yap" Click="OnSignOut" IsEnabled="{x:Bind Patreon.CanSignOut, Mode=OneWay}" />
                                    <ProgressRing IsActive="{x:Bind Patreon.Busy, Mode=OneWay}" Width="16" Height="16" />
                                </StackPanel>
                            </StackPanel>
                            <InfoBar IsOpen="{x:Bind Patreon.HasProblem, Mode=OneWay}" Visibility="{x:Bind Patreon.HasProblem, Mode=OneWay}" Message="{x:Bind Patreon.Problem, Mode=OneWay}"
                                     Severity="Warning" IsClosable="False" />
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="4">
                                <CheckBox IsChecked="{x:Bind Patreon.UseCommunityDb, Mode=TwoWay}" IsEnabled="{x:Bind Patreon.HasDb, Mode=OneWay}" AutomationProperties.Name="Paylaşılan shader hash'lerini indir">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Paylaşılan shader hash'lerini indir" TextWrapping="Wrap" />
                                        <TextBlock Text="Diğer oyuncuların kaydettiği hash'lerle oyunlarınızı derleyin."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                            <CheckBox IsChecked="{x:Bind Vm.ShareDiagnostics, Mode=TwoWay}" AutomationProperties.Name="Sorunları çözmeye yardımcı olmak için tanı verilerini paylaş">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Sorunları çözmeye yardımcı olmak için tanı verilerini paylaş" TextWrapping="Wrap" />
                                    <TextBlock Text="Bir derleme başarısız olursa hata kodlarını her derleme için bir kez gönderin." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="Neyi paylaşıldı" NavigateUri="https://scskiller.com/privacy" Padding="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Derleme hızı: kuyruk çalışırken" Style="{StaticResource Section}" />
                            <Grid>
                                <TextBlock Text="Derleme iş parçacıkları" />
                                <TextBlock Text="{x:Bind Vm.ThreadsText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{x:Bind Vm.MaxThreads}" StepFrequency="1" Value="{x:Bind Vm.Threads, Mode=TwoWay}"
                                    AutomationProperties.Name="Derleme iş parçacıkları" />
                            <TextBlock Text="{x:Bind Vm.PriorityNote, Mode=OneWay}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
