<Project>

  <!-- Her derleme (assembly) ve exe üzerindeki ürün meta verileri (SignPath imzalı her dosyanın ürün adını ve sürümünü kontrol eder). Sürüm etiketten (tag) gelir: build/publish.ps1 -p:Version=<v olmayan etiket> argümanını geçirir ve +sha ekini kapatır, böylece bir sürümün her dosyası aynı sürümü raporlar. Düz bir derleme 0.0.0-internal.0+<commit sha> şeklindedir (SourceLink sha'yı ekler). -->
  <PropertyGroup>
    <Product>SCSKiller</Product>
    <Company>The SCSKiller authors</Company>
    <Authors>The SCSKiller authors</Authors>
    <Copyright>Copyright (C) 2026 The SCSKiller authors</Copyright>
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>internal.0</VersionSuffix>
  </PropertyGroup>

  <!-- CET uyumlu .NET exe'leri, CET özel kullanıcı modu APC'leri olmayan Windows 10 yapılarında başlangıçta anında hata verir (fail-fast 0x80131506) -->
  <PropertyGroup>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

</Project>
